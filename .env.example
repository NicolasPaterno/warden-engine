# Copy this file to .env and adjust as needed. .env is gitignored.
#
#   cp .env.example .env

# --- NATS ---
NATS_URL=nats://localhost:4222

# --- PostgreSQL ---
# sslmode=disable is required for the local docker-compose Postgres
# (also used by golang-migrate, which would otherwise demand TLS).
DATABASE_URL=postgres://postgres:warden@localhost:5432/warden_engine_db?sslmode=disable

# --- HTTP server ---
HTTP_PORT=:8081

# --- Tracing (OTel/Jaeger collector) ---
JAEGER_ENDPOINT=localhost:4318

# --- Auth (JWT verification on protected routes) ---
# Points at the warden-auth service. Not needed for the NATS -> alert path,
# only for the protected REST endpoints.
JWKS_URL=http://localhost:8082/.well-known/jwks.json
ISSUER=warden-auth
AUDIENCE=warden-engine
